{
  "name": "@tpural/ui",
  "version": "0.2.2",
  "description": "tapslab component library and theme system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpural/tapslab-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./themes": "./src/themes/index.ts",
    "./themes.css": "./src/themes/themes.css",
    "./tailwind.css": "./src/themes/tailwind.css",
    "./theme": "./src/theme/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "themes:build": "tsx scripts/build-themes.ts",
    "themes:check": "tsx scripts/build-themes.ts --check && tsx scripts/check-contrast.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run themes:check && npm run typecheck && npm run test",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  }
}
