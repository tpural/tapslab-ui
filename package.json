{
  "name": "@tpural/ui",
  "version": "0.2.1",
  "description": "tapslab component library and theme system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpural/tapslab-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./themes": "./src/themes/index.ts",
    "./themes.css": "./src/themes/themes.css",
    "./tailwind.css": "./src/themes/tailwind.css",
    "./theme": "./src/theme/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "themes:build": "tsx scripts/build-themes.ts",
    "themes:check": "tsx scripts/build-themes.ts --check && tsx scripts/check-contrast.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run themes:check && npm run typecheck"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
